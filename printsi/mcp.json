{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "printsi": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/printsi.mjs",
        "mcp"
      ],
      "env": {
        "PRINTSI_CONFIG_DIR": "${PLUGIN_DATA}/printsi",
        "PRINTSI_TELEMETRY": "0"
      }
    }
  }
}
